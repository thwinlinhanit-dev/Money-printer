# Feature catalog params (FEA-7) — EXAMPLE. Copy to features.toml and edit.
# All catalog params live here, in ONE file, parsed with deny_unknown_fields
# (a mistyped key is an error, not a silent default). This file's canonical
# hash is written into every materialized feature's Parquet footer (FEA-6);
# changing any value forces a new `ver=N` feature-store directory — recorded
# feature data is never overwritten (W-6).

# Bar timeframe for bar-derived features, in nanoseconds (default 60s).
bar_tf_ns = 60000000000

[cvd]
# Per-venue cumulative volume delta is computed for these venue slugs.
venues = ["bybit", "okx", "binance"]

[whale_print]
# A single trade at or above this notional is a whale print.
min_notional = 250000.0
# Default: Hyperliquid only (large-print edge on HL public tape).
venues = ["hyperliquid"]

[whale_net]
# Aggregate whale net positioning + deltas (spec 028 census → feature engine
# 004, after the RES-4 event study): per-symbol sum of signed position
# notional across recorded addresses (`whale.net.{venue}`) and its change vs
# the previous reading (`whale.delta.{venue}`). Only venues with a recorded
# WhalePosition census make sense (default: hyperliquid).
venues = ["hyperliquid"]
# A position not refreshed within this window (ns) is evicted from the
# census — a flattened position or a leaderboard drop-off must not linger
# in the aggregate. Default 10 min (~10 top-N polls at the 60s cadence).
stale_after_ns = 600000000000

[liq_cluster]
# Liquidations within this window (ns) summing to >= min_cluster_notional
# form a cluster.
window_ns = 60000000000
min_cluster_notional = 5000000.0

[liq_agg]
# Cross-venue de-sampled liquidation tape (spec 029). Dedup near-simultaneous
# reports of the same liquidation across venues within dedup_window_ns, then
# emit the rolling signed notional over agg_window_ns. Sampled: venues
# throttle, this is a best-effort merged tape, not a census.
dedup_window_ns = 250000000
agg_window_ns = 1000000000

[liq_est_bands]
# Estimated liquidation cascade bands (spec 029), from OI + mark + leverage
# tiers. ESTIMATED (model), not ground truth — validate against spec 028 real
# liq prices (RES-4) before any strategy use.
maintenance_buffer = 1.5
# leverage tiers + OI weights — DOCUMENTED ASSUMPTIONS until calibrated from
# the recorded spec 028 real leverage distribution:
#   cargo run -p mp-features --bin whale_study -- --log <positions.log> --leverage-calibration --json
#   python3 research/run_calibrate_leverage.py --log <positions.log> --print-toml   (spec 029 LIQ-11)
[[liq_est_bands.leverage_tiers]]
leverage = 1.0
weight = 0.05
[[liq_est_bands.leverage_tiers]]
leverage = 2.0
weight = 0.10
[[liq_est_bands.leverage_tiers]]
leverage = 5.0
weight = 0.15
[[liq_est_bands.leverage_tiers]]
leverage = 10.0
weight = 0.25
[[liq_est_bands.leverage_tiers]]
leverage = 20.0
weight = 0.25
[[liq_est_bands.leverage_tiers]]
leverage = 50.0
weight = 0.20

[microstructure]
# Top-of-book microstructure features (research-driven edge): microprice
# (qty-weighted mid, `microprice.{venue}`), quoted spread in bps of mid
# (`spread.bp.{venue}`), and the wide-spread regime gate (`spread.regime.
# {venue}` — 1 when the quoted spread ≥ wide_spread_bps; predictability
# collapses in wide-spread regimes). Book-based: venues with a book stream.
venues = ["hyperliquid"]
# Default regime threshold: 2 bps of mid.
wide_spread_bps = 2.0

[swing]
# HTF regime + value area + structural levels (spec 035 SWG-2). Bar-only —
# none of these depend on L2 order book or trade-tape input (SWG-2 MUST NOT).
# Windows are in bar counts on the engine's bar timeframe (bar_tf_ns).
realized_vol_window = 20
# sqrt(bars/year) annualization for swing.realized_vol. Default derives from
# bar_tf_ns (≈725 for 60s bars); override to align with the materialized bar
# timeframe (e.g. daily bars → √365 ≈ 19.1).
sqrt_bars_per_year = 725.2
trend_lookback = 20
value_area_window = 48
value_area_bucket = 50.0
rolling_vwap_bars = 48
# Liquidity structure (spec 036 SLQ): compressed-range sweep detection and
# the HVN/LVN profile levels. All bar-only (SWG-2); defaults shown.
sweep_range_n = 20        # range window (bars)
sweep_compress_frac = 0.6 # mean TR of window < frac × pre-window baseline ATR
sweep_atr_n = 20          # baseline ATR length, computed BEFORE the window
sweep_atr_mult = 0.1      # wick must clear boundary by >= mult × baseline ATR
sweep_reclaim_z = 2       # closes back inside allowed within z bars
sweep_vol_mult = 1.5      # sweep-bar volume >= mult × window mean
sweep_stop_buffer_atr = 0.5 # invalidation = extreme ∓ buffer × ATR (carried on the event)
profile_window = 90        # HVN/LVN lookback (bars)
profile_hvn_frac = 0.7     # local maxima above this fraction of POC volume
profile_lvn_frac = 0.3     # local minima below this fraction of POC volume
# Spec 036 §7 confluence: POC-flip acceptance + A/D classifier windows.
poc_flip_n = 3             # closes on the far side (<=1 back across) to confirm a flip
ad_k_windows = 3           # near-VAL/VAH volume ratio compares last K vs prior K bars
# IBIT <-> Deribit cross-market family (spec 040). Disabled by default;
# set deriv_underlying to enable (divergence + flow lead-lag lags 0..2).
[ibit_cross]
deriv_underlying = "BTC"
ibit_underlying = "IBIT"
min_overlap_days = 5
ibit_multiplier = 100.0
hist_days = 90

[options_greeks]
# Options chain Greeks aggregation (spec 037 GRE) — global features
# (gex.net.{u}, gex.max_pain.{u}, net.{delta,vega,theta}.{u}, vanna/volga/
# charm.{u}). DISABLED when underlyings is empty; enable per underlying.
# underlyings = ["BTC", "ETH"]
# Contract multiplier: Deribit = 1.0 (1 BTC/ETH per contract). Spec 040 sets
# 100 for IBIT (US equity standard).
contract_multiplier = 1.0

[options_iv]
# IV surface analytics (spec 038 IVS): iv.atm.{u}, iv.term.{u}.{tenor},
# iv.skew.{u}.rr25/wing25, iv.index.{u}, iv.percentile.{u}, iv.regime.{u}.
# DISABLED when underlyings is empty.
# underlyings = ["BTC", "ETH"]
tenors = [
    { name = "1w", days = 7.0 },
    { name = "1m", days = 30.0 },
    { name = "3m", days = 90.0 },
    { name = "6m", days = 180.0 },
]
# Rolling percentile windows (days). Only OBSERVED days count (IVS-11) —
# collector downtime never dilutes the denominator.
percentile_window_days = 365
# Regime lookback (IVS-6). Encoding is REVERSE-ORDINAL: 0=Rich, 1=Fair,
# 2=Cheap (see spec 038 warning — do not flip after materialization).
regime_lookback_days = 90

[options_flow]
# Options flow aggregation (spec 039 OFI): flow.*.{u}.{window} — emitted on
# window close. DISABLED when underlyings is empty.
# underlyings = ["BTC", "ETH"]
windows_ns = [3600000000000, 14400000000000, 86400000000000]  # 1h/4h/24h
contract_multiplier = 1.0
# Block trade threshold, USD notional (OFI-2) — USD normalizes BTC vs ETH
# vs IBIT contract sizes.
block_threshold_usd = 100000.0
# Whale threshold = max(floor, k × p95 of the window's notionals) (OFI-8).
whale_floor_usd = 500000.0
k_whale = 3.0
# Kind-aware moneyness bands (OFI-5): ATM ±2%; ITM within 10% on the ITM
# side; OTM within 50% on the OTM side; deeper trades excluded.
atm_threshold = 0.02
itm_cap = 0.10
otm_cap = 0.50
# Days-to-expiry tenor boundaries (OFI-6): ≤7 weekly, ≤45 monthly,
# ≤180 quarterly, else leap.
weekly_max_days = 7.0
monthly_max_days = 45.0
quarterly_max_days = 180.0

[cohort]
# Wallet cohort grading (spec 042 WCG). All four live aggregates register
# when enabled: cohort.whale_ratio, cohort.net_delta.{cohort},
# cohort.smart_flow.{w}, cohort.concentration. Fail-closed (WCG-8): with no
# snapshot loaded every cohort.* feature emits None.
enabled = false
# snapshot_path = "data/cohorts/2026-08-23.json"  # weekly scorer output
[cohort.inner]
smart_flow_window_ns = 86400000000000  # 24h -> feature id cohort.smart_flow.24h
snapshot_max_age_ns = 604800000000000  # 7d staleness cap for live features

[netflow_flow]
# CEX flow velocity (spec 043 CFV): netflow.velocity.w{i},
# netflow.acceleration.w{i}, netflow.cumulative, netflow.regime,
# netflow.zscore. DISABLED when enabled is false.
enabled = false
[netflow_flow.inner]
windows_ns = [3600000000000, 14400000000000, 86400000000000]  # 1h/4h/24h
cumulative_window_ns = 604800000000000  # 7d trapezoidal integration
regime_lookback_days = 90               # percentile history cap (CFV-4)
zscore_window_ns = 86400000000000       # 24h trailing stats
min_regime_obs = 20                     # velocities before regime classifies
stale_after_ns = 600000000000           # 2x spec 034 poll cadence (CFV-8)

[accumulation]
# Accumulation detector (spec 045 ACC): compound AND of OI rising + smart
# money buying + exchange outflow; emits ScreenerHits under
# rule_id "accumulation_detector". Feature-name defaults reference the
# cohort.*/netflow.* families above - both must be fed for the detector to fire.
enabled = false
[accumulation.inner]
cooldown_ns = 14400000000000            # 4h between hits per asset (ACC-4)
percentile_window_ns = 604800000000000  # 7d dynamic thresholds (ACC-3)
oi_delta_percentile = 0.80              # top-quintile OI increase
smart_flow_percentile = 0.70            # top-30% smart flow
whale_ratio_floor = 0.10                # min whale share of OI
outflow_regime = 2.0                    # netflow.regime encoding for Outflow

[oi_regime]
# OI/price regime inputs for the accumulation detector (spec 045):
# oi.delta.{w}, oi.quadrant.{w} (tick) + regime.trend (bar, swing efficiency
# ratio; 0=Trend / 1=Chop). DISABLED when enabled is false.
enabled = false
[oi_regime.inner]
windows_ns = [14400000000000]  # 4h -> oi.delta.4h / oi.quadrant.4h
trend_lookback_bars = 20
trend_threshold = 0.25         # |efficiency ratio| >= threshold => Trend

[corr]
# Cross-asset regime correlations (spec 048), computed from our own recorded
# BTC/ETH trades plus FRED/DeFiLlama/Coinalyze MacroPoints. Regime conditioner
# only — never standalone entry (COR-4). Enable once legs have daily history.
enabled = false

# Core crypto + TradFi pairs
[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "hyperliquid", symbol = "ETH" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "fred", symbol = "GOLDAMGBD228NLBM" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "fred", symbol = "SP500" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "ETH" }
leg_b = { venue = "fred", symbol = "SP500" }

# DeFiLlama regime series (spec 046) — regime-grade, never execution-grade.
[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "defillama", symbol = "DEFI_TVL_AGG" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "defillama", symbol = "STABLECOIN_MCAP" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "defillama", symbol = "DEX_VOL_1D" }

# Coinalyze cross-exchange validation (spec 047) — validation/context, NOT alpha.
[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "coinalyze", symbol = "AGG_OI_BTC" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "coinalyze", symbol = "AGG_FUNDING_BTC" }

[[corr.pairs]]
window_days = 30
min_overlap_days = 10
leg_a = { venue = "hyperliquid", symbol = "BTC" }
leg_b = { venue = "coinalyze", symbol = "AGG_LS_BTC" }

# Regime classification thresholds for corr.* values (spec 048 regime wiring).
# corr_regime.* features consume the raw Pearson r and emit regime labels
# (0=risk_on, 1=neutral, 2=risk_off) that feed regime_fit_from_features.
[corr.regime]
btc_spx_risk_off_threshold = 0.7   # corr.btc_sp500 >= 0.7 → risk_off
btc_spx_risk_on_threshold = 0.3    # corr.btc_sp500 <= 0.3 → risk_on
btc_gold_risk_off_threshold = -0.3 # corr.btc_gold <= -0.3 → risk_off (crypto≠safe-haven)
stablecoin_expand_threshold = 1.05 # stablecoin supply growth > 5% → risk_on

[climax_variants]
# 6 non-standard exhaustion/expansion patterns discovered from BTC daily
# analysis 2017-2026. The standard climax detector (spec 004 climax.{tf})
# catches only ~7.5% of potential reversal signals — these fill the gap.
# Bar-only (SWG-2 compatible), disabled by default.
enabled = false

[footprint_signals]
# Footprint signal catalog (spec 049): volume.bubble + market.profile.
# Volume bubble: percentile rank of volume over rolling window.
# Market profile: POC (Point of Control) + VAH/VAL (Value Area High/Low).
# Disabled by default.
enabled = false
# Rolling window (bars) for volume percentile rank.
volume_bubble_window = 100
# Rolling window (bars) for market profile POC/VAH/VAL.
market_profile_window = 50
# Bucket size as an ABSOLUTE price width for market profile buckets
# (not ATR-derived — see spec 049 amendment, A-6 audit 2026-09-02).
market_profile_bucket_width = 0.5
