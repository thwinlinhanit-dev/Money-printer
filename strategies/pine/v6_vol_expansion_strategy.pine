// NON-EVIDENCE: not in funnel until ported to Rust sim (spec 053 ALP-4)
// ═══════════════════════════════════════════════════════════════
// V6 VOL EXPANSION STRATEGY
// Strongest: 100% win rate (5 trades), Sharpe 16.01
// Timeframe: Weekly recommended
// NOTE: Rare signals (5 in 9 years) - size up when it fires
// ═══════════════════════════════════════════════════════════════
//@version=6
strategy("V6 Vol Expansion", overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=3,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=5)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
// Detection
atrLen         = input.int(14, "ATR Length")
atrShortLen    = input.int(8, "ATR Short")
atrLongLen     = input.int(30, "ATR Long")
expansionThresh = input.float(1.8, "ATR Expansion Threshold ×", step=0.1)

// Trend Filter
useTrendFilter = input.bool(true, "Use Trend Filter")
smaLen         = input.int(50, "SMA Length")

// Risk Management
trailATR       = input.float(3.0, "Trailing Stop (× ATR)", step=0.5)
tpPct          = input.float(20.0, "Take Profit % (0 = no TP)", step=1.0)
maxHoldBars    = input.int(84, "Max Hold Bars (84 = 12w weekly)")

// ═══════════════════════════════════════════════════════════════
// DETECTION: Volatility Expansion
// ═══════════════════════════════════════════════════════════════
atr = ta.atr(atrLen)
atrShort = ta.atr(atrShortLen)
atrLong = ta.atr(atrLongLen)

// ATR jumps > 1.8x long ATR
volExpansion = atrLong > 0 and atrShort > atrLong * expansionThresh

// ═══════════════════════════════════════════════════════════════
// TREND FILTER
// ═══════════════════════════════════════════════════════════════
sma = ta.sma(close, smaLen)
inUptrend = close > sma
inDowntrend = close < sma

// Apply filter
buySignal = volExpansion and inUptrend and (useTrendFilter ? true : true)
sellSignal = volExpansion and inDowntrend and (useTrendFilter ? true : false)

// ═══════════════════════════════════════════════════════════════
// ENTRY
// ═══════════════════════════════════════════════════════════════
if buySignal and strategy.position_size == 0
    strategy.entry("V6 Long", strategy.long)

if sellSignal and strategy.position_size == 0
    strategy.entry("V6 Short", strategy.short)

// ═══════════════════════════════════════════════════════════════
// EXIT: Trailing Stop + Take Profit + Time Stop
// ═══════════════════════════════════════════════════════════════
var float trailPrice = na
var int entryBar = 0
var float entryPrice = 0

if strategy.position_size != 0
    if strategy.position_size > 0
        newTrail = close - trailATR * atr
        trailPrice := math.max(nz(trailPrice, newTrail), newTrail)
        
        tpLevel = entryPrice * (1 + tpPct / 100)
        if tpPct > 0 and close >= tpLevel
            strategy.exit("TP", "V6 Long", limit=tpLevel)
        
        strategy.exit("Trail", "V6 Long", stop=trailPrice)
        
        if bar_index - entryBar >= maxHoldBars
            strategy.close("V6 Long", comment="Time Stop")
    
    else
        newTrail = close + trailATR * atr
        trailPrice := math.min(nz(trailPrice, newTrail), newTrail)
        
        tpLevel = entryPrice * (1 - tpPct / 100)
        if tpPct > 0 and close <= tpLevel
            strategy.exit("TP", "V6 Short", limit=tpLevel)
        
        strategy.exit("Trail", "V6 Short", stop=trailPrice)
        
        if bar_index - entryBar >= maxHoldBars
            strategy.close("V6 Short", comment="Time Stop")

if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryBar := bar_index
    entryPrice := close
    trailPrice := na

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(sma, "SMA", color=color.new(color.white, 50))
plot(trailPrice, "Trail Stop", color=color.new(color.orange, 30), style=plot.style_linebr)

plotshape(buySignal, "Buy Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(buySignal, "V6 Buy", "Vol Expansion BUY signal")
alertcondition(sellSignal, "V6 Sell", "Vol Expansion SELL signal")
