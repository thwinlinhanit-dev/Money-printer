// NON-EVIDENCE: not in funnel until ported to Rust sim (spec 053 ALP-4)
// ═══════════════════════════════════════════════════════════════
// V1 + V5 COMPOSITE STRATEGY
// Sniper entries: When both patterns fire together
// Historical: 100% win rate (5 trades), Sharpe 41
// Timeframe: Weekly recommended
// ═══════════════════════════════════════════════════════════════
//@version=6
strategy("V1V5 Composite", overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=3,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=5)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
// V1 Detection
trendLen       = input.int(20, "V1: Trend Lookback")
volMALen       = input.int(20, "V1: Volume MA Length")
volMult        = input.float(2.0, "V1: Volume Spike ×", step=0.1)
atrLen         = input.int(14, "ATR Length")
spreadMult     = input.float(1.5, "V1: Spread vs ATR ×", step=0.1)
closePosThresh = input.float(0.55, "V1: Close Position Threshold", step=0.05)

// V5 Detection
wickRatio      = input.float(2.0, "V5: Min Wick/Body Ratio", step=0.1)
bodyPctMax     = input.float(0.15, "V5: Max Body % of Range", step=0.05)
volSpikeV5     = input.float(1.2, "V5: Volume Spike × MA", step=0.1)

// Trend Filter
useTrendFilter = input.bool(true, "Use Trend Filter")
smaLen         = input.int(50, "SMA Length")

// Risk Management
trailATR       = input.float(2.0, "Trailing Stop (× ATR)", step=0.5)
tpPct          = input.float(0.0, "Take Profit % (0 = no TP)", step=1.0)
maxHoldBars    = input.int(56, "Max Hold Bars (56 = 8w weekly)")

// ═══════════════════════════════════════════════════════════════
// V1 DETECTION: Volume Exhaustion
// ═══════════════════════════════════════════════════════════════
atr = ta.atr(atrLen)
volMA = ta.sma(volume, volMALen)
spread = high - low
closePos = spread == 0 ? 0.5 : (close - low) / spread

// V1 criteria
volSpike = volume > volMA * volMult
wideSpread = spread > atr * spreadMult
midClosePos = closePos > (1 - closePosThresh) and closePos < closePosThresh

v1Signal = volSpike and wideSpread and midClosePos

// ═══════════════════════════════════════════════════════════════
// V5 DETECTION: Absorption Bar
// ═══════════════════════════════════════════════════════════════
range = high - low
body = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// V5 criteria
isSmallBody = range > 0 and (body / range) <= bodyPctMax
hasLongWick = range > 0 and (math.max(upperWick, lowerWick) / math.max(body, 0.0001)) >= wickRatio
volConfirmV5 = volume > volMA * volSpikeV5

v5Signal = isSmallBody and hasLongWick and volConfirmV5

// ═══════════════════════════════════════════════════════════════
// COMPOSITE: V1 + V5 Confluence
// ═══════════════════════════════════════════════════════════════
compositeSignal = v1Signal and v5Signal

// ═══════════════════════════════════════════════════════════════
// TREND FILTER
// ═══════════════════════════════════════════════════════════════
sma = ta.sma(close, smaLen)
inUptrend = close > sma
inDowntrend = close < sma

// Apply filter
buySignal = compositeSignal and (useTrendFilter ? inUptrend : true)
sellSignal = compositeSignal and (useTrendFilter ? inDowntrend : true)

// ═══════════════════════════════════════════════════════════════
// ENTRY
// ═══════════════════════════════════════════════════════════════
if buySignal and strategy.position_size == 0
    strategy.entry("V1V5 Long", strategy.long)

if sellSignal and strategy.position_size == 0
    strategy.entry("V1V5 Short", strategy.short)

// ═══════════════════════════════════════════════════════════════
// EXIT: Trailing Stop + Time Stop
// ═══════════════════════════════════════════════════════════════
var float trailPrice = na
var int entryBar = 0
var float entryPrice = 0

if strategy.position_size != 0
    if strategy.position_size > 0
        newTrail = close - trailATR * atr
        trailPrice := math.max(nz(trailPrice, newTrail), newTrail)
        
        tpLevel = entryPrice * (1 + tpPct / 100)
        if tpPct > 0 and close >= tpLevel
            strategy.exit("TP", "V1V5 Long", limit=tpLevel)
        
        strategy.exit("Trail", "V1V5 Long", stop=trailPrice)
        
        if bar_index - entryBar >= maxHoldBars
            strategy.close("V1V5 Long", comment="Time Stop")
    
    else
        newTrail = close + trailATR * atr
        trailPrice := math.min(nz(trailPrice, newTrail), newTrail)
        
        tpLevel = entryPrice * (1 - tpPct / 100)
        if tpPct > 0 and close <= tpLevel
            strategy.exit("TP", "V1V5 Short", limit=tpLevel)
        
        strategy.exit("Trail", "V1V5 Short", stop=trailPrice)
        
        if bar_index - entryBar >= maxHoldBars
            strategy.close("V1V5 Short", comment="Time Stop")

if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryBar := bar_index
    entryPrice := close
    trailPrice := na

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(sma, "SMA", color=color.new(color.white, 50))
plot(trailPrice, "Trail Stop", color=color.new(color.orange, 30), style=plot.style_linebr)

plotshape(v1Signal, "V1 Only", shape.circle, location.belowbar, color.new(color.aqua, 50), size=size.tiny)
plotshape(v5Signal, "V5 Only", shape.circle, location.abovebar, color.new(color.purple, 50), size=size.tiny)
plotshape(compositeSignal, "V1V5 Composite", shape.diamond, location.belowbar, color.yellow, size=size.small)
plotshape(buySignal, "Buy Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(compositeSignal, "V1V5 Composite", "V1+V5 CONFLUENCE signal")
alertcondition(buySignal, "V1V5 Buy", "V1V5 Composite BUY signal")
alertcondition(sellSignal, "V1V5 Sell", "V1V5 Composite SELL signal")
