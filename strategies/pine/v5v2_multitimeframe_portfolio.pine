// ═══════════════════════════════════════════════════════════════
// V5 WEEKLY + V2 DAILY — MULTI-TIMEFRAME PORTFOLIO
// Combines two uncorrelated signals with dynamic sizing
// V5 Weekly: Swing trades (8-12 week hold)
// V2 Daily: Range breakouts (21 day hold)
// Correlation-aware: Reduces size when signals overlap
// ═══════════════════════════════════════════════════════════════
//@version=6
strategy("V5V2 Multi-TF Portfolio", overlay=true, 
     default_qty_type=strategy.fixed,
     default_qty_value=0,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=5)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
// V5 Detection (Weekly)
v5WickRatio     = input.float(2.0, "V5: Min Wick/Body Ratio", step=0.1)
v5BodyPctMax    = input.float(0.15, "V5: Max Body % of Range", step=0.05)
v5VolSpike      = input.float(1.2, "V5: Volume Spike × MA", step=0.1)
v5VolMALen      = input.int(20, "V5: Volume MA Length")

// V2 Detection (Daily)
v2MinStreak     = input.int(3, "V2: Min Down Days")
v2ContainWin    = input.int(15, "V2: Containment Window")
v2BreakoutBuf   = input.float(0.15, "V2: Breakout Buffer (× ATR)", step=0.05)
v2BreakoutVol   = input.float(1.1, "V2: Breakout Volume ×", step=0.05)

// Trend Filter
useTrendFilter  = input.bool(true, "Use Trend Filter")
smaLen          = input.int(50, "SMA Length")

// Portfolio Sizing
totalAlloc      = input.float(100, "Total Allocation %", step=5)
v5BaseAlloc     = input.float(60, "V5 Base Allocation %", step=5)
v2BaseAlloc     = input.float(40, "V2 Base Allocation %", step=5)
corrReduction   = input.float(0.5, "Correlation Reduction Factor", step=0.1)
maxCorr         = input.float(0.7, "Max Correlation Threshold", step=0.1)

// Risk Management
atrLen          = input.int(14, "ATR Length")
v5TrailATR      = input.float(3.0, "V5: Trailing Stop (× ATR)", step=0.5)
v5MaxHold       = input.int(84, "V5: Max Hold Bars (84 = 12w)")
v2TrailATR      = input.float(1.5, "V2: Trailing Stop (× ATR)", step=0.5)
v2MaxHold       = input.int(21, "V2: Max Hold Bars (21 = 3w)")

// ═══════════════════════════════════════════════════════════════
// CORRELATION TRACKING
// ═══════════════════════════════════════════════════════════════
// Track recent V5 and V2 signals to compute correlation
// High correlation → reduce position size
// ═══════════════════════════════════════════════════════════════

var float[] v5_returns = array.new_float(0)
var float[] v2_returns = array.new_float(0)
var float current_corr = 0.0

// Store recent returns
if bar_index > 0
    daily_ret = (close - close[1]) / close[1]
    
    // Decay old returns (keep last 20)
    if array.size(v5_returns) > 20
        array.shift(v5_returns)
    if array.size(v2_returns) > 20
        array.shift(v2_returns)

// Compute correlation when we have enough data
compute_correlation() =>
    n = math.min(array.size(v5_returns), array.size(v2_returns))
    if n < 5
        0.0
    else
        // Simple correlation: check if V5 and V2 signals are in same direction
        v5_sum = 0.0
        v2_sum = 0.0
        v5_sq = 0.0
        v2_sq = 0.0
        v5v2_sum = 0.0
        
        for i = 0 to n - 1
            v5_r = array.get(v5_returns, i)
            v2_r = array.get(v2_returns, i)
            v5_sum += v5_r
            v2_sum += v2_r
            v5_sq += v5_r * v5_r
            v2_sq += v2_r * v2_r
            v5v2_sum += v5_r * v2_r
        
        mean_v5 = v5_sum / n
        mean_v2 = v2_sum / n
        var_v5 = v5_sq / n - mean_v5 * mean_v5
        var_v2 = v2_sq / n - mean_v2 * mean_v2
        cov = v5v2_sum / n - mean_v5 * mean_v2
        
        if var_v5 > 0 and var_v2 > 0
            cov / math.sqrt(var_v5 * var_v2)
        else
            0.0

// ═══════════════════════════════════════════════════════════════
// V5 DETECTION (Weekly Logic on Daily)
// ═══════════════════════════════════════════════════════════════
atr = ta.atr(atrLen)
range = high - low
body = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// V5 Absorption criteria
v5IsSmallBody = range > 0 and (body / range) <= v5BodyPctMax
v5HasLongWick = range > 0 and (math.max(upperWick, lowerWick) / math.max(body, 0.0001)) >= v5WickRatio
v5BuyersAbsorbing = lowerWick > upperWick
v5SellersAbsorbing = upperWick > lowerWick

volMA = ta.sma(volume, v5VolMALen)
v5VolConfirm = volume > volMA * v5VolSpike

v5Buy = v5IsSmallBody and v5HasLongWick and v5BuyersAbsorbing and v5VolConfirm
v5Sell = v5IsSmallBody and v5HasLongWick and v5SellersAbsorbing and v5VolConfirm

// ═══════════════════════════════════════════════════════════════
// V2 DETECTION (Daily)
// ═══════════════════════════════════════════════════════════════
// Count consecutive down days
var int downStreak = 0
if close < close[1]
    downStreak += 1
else
    downStreak := 0

// Range formation after exhaustion
var bool inRange = false
var float rangeHigh = na
var float rangeLow = na

if downStreak >= v2MinStreak and not inRange
    inRange := true
    rangeHigh := ta.highest(high, v2ContainWin)
    rangeLow := ta.lowest(low, v2ContainWin)

if inRange
    rangeHigh := math.max(rangeHigh, ta.highest(high, v2ContainWin))
    rangeLow := math.min(rangeLow, ta.lowest(low, v2ContainWin))
    
    // Exit if too wide
    if rangeHigh - rangeLow > 6 * atr
        inRange := false

// Breakout detection
v2BreakoutUp = inRange and close > rangeHigh + v2BreakoutBuf * atr and volume > volMA * v2BreakoutVol
v2BreakoutDown = inRange and close < rangeLow - v2BreakoutBuf * atr and volume > volMA * v2BreakoutVol

// ═══════════════════════════════════════════════════════════════
// TREND FILTER
// ═══════════════════════════════════════════════════════════════
sma = ta.sma(close, smaLen)
inUptrend = close > sma
inDowntrend = close < sma

// Apply filters
v5BuySignal = v5Buy and (useTrendFilter ? inUptrend : true)
v5SellSignal = v5Sell and (useTrendFilter ? inDowntrend : true)
v2BuySignal = v2BreakoutUp and (useTrendFilter ? inUptrend : true)
v2SellSignal = v2BreakoutDown and (useTrendFilter ? inDowntrend : true)

// ═══════════════════════════════════════════════════════════════
// CORRELATION-AWARE SIZING
// ═══════════════════════════════════════════════════════════════
// When both signals fire together:
// - High correlation → reduce total size
// - Low correlation → full size
// ═══════════════════════════════════════════════════════════════

bothSignals = (v5BuySignal or v5SellSignal) and (v2BuySignal or v2SellSignal)

// Compute effective allocation
corr = current_corr
corrFactor = math.abs(corr) > maxCorr ? (1 - corrReduction) : 1.0

// Base allocations
v5Alloc = v5BaseAlloc * totalAlloc / 100 * corrFactor
v2Alloc = v2BaseAlloc * totalAlloc / 100 * corrFactor

// If only one signal, use full allocation for that strategy
if (v5BuySignal or v5SellSignal) and not (v2BuySignal or v2SellSignal)
    v5Alloc := totalAlloc / 100
    v2Alloc := 0.0

if (v2BuySignal or v2SellSignal) and not (v5BuySignal or v5SellSignal)
    v5Alloc := 0.0
    v2Alloc := totalAlloc / 100

// ═══════════════════════════════════════════════════════════════
// ENTRY LOGIC
// ═══════════════════════════════════════════════════════════════
var bool inV5 = false
var bool inV2 = false
var float v5Entry = 0
var float v2Entry = 0
var int v5EntryBar = 0
var int v2EntryBar = 0
var float v5Trail = na
var float v2Trail = na

// V5 Entry
if v5BuySignal and not inV5 and v5Alloc > 0
    qty = strategy.equity * v5Alloc / close
    strategy.entry("V5 Long", strategy.long, qty=qty)
    inV5 := true
    v5Entry := close
    v5EntryBar := bar_index

if v5SellSignal and not inV5 and v5Alloc > 0
    qty = strategy.equity * v5Alloc / close
    strategy.entry("V5 Short", strategy.short, qty=qty)
    inV5 := true
    v5Entry := close
    v5EntryBar := bar_index

// V2 Entry
if v2BuySignal and not inV2 and v2Alloc > 0
    qty = strategy.equity * v2Alloc / close
    strategy.entry("V2 Long", strategy.long, qty=qty)
    inV2 := true
    v2Entry := close
    v2EntryBar := bar_index
    inRange := false

if v2SellSignal and not inV2 and v2Alloc > 0
    qty = strategy.equity * v2Alloc / close
    strategy.entry("V2 Short", strategy.short, qty=qty)
    inV2 := true
    v2Entry := close
    v2EntryBar := bar_index
    inRange := false

// ═══════════════════════════════════════════════════════════════
// EXIT LOGIC
// ═══════════════════════════════════════════════════════════════
// V5 Exit (trailing stop + time stop)
if inV5
    if strategy.position_size > 0
        v5Trail := math.max(nz(v5Trail, close - v5TrailATR * atr), close - v5TrailATR * atr)
        strategy.exit("V5 Trail", "V5 Long", stop=v5Trail)
        
        if bar_index - v5EntryBar >= v5MaxHold
            strategy.close("V5 Long", comment="V5 Time Stop")
            inV5 := false
    
    else if strategy.position_size < 0
        v5Trail := math.min(nz(v5Trail, close + v5TrailATR * atr), close + v5TrailATR * atr)
        strategy.exit("V5 Trail", "V5 Short", stop=v5Trail)
        
        if bar_index - v5EntryBar >= v5MaxHold
            strategy.close("V5 Short", comment="V5 Time Stop")
            inV5 := false

// V2 Exit (trailing stop + time stop)
if inV2
    if strategy.position_size > 0
        v2Trail := math.max(nz(v2Trail, close - v2TrailATR * atr), close - v2TrailATR * atr)
        strategy.exit("V2 Trail", "V2 Long", stop=v2Trail)
        
        if bar_index - v2EntryBar >= v2MaxHold
            strategy.close("V2 Long", comment="V2 Time Stop")
            inV2 := false
    
    else if strategy.position_size < 0
        v2Trail := math.min(nz(v2Trail, close + v2TrailATR * atr), close + v2TrailATR * atr)
        strategy.exit("V2 Trail", "V2 Short", stop=v2Trail)
        
        if bar_index - v2EntryBar >= v2MaxHold
            strategy.close("V2 Short", comment="V2 Time Stop")
            inV2 := false

// Reset state on exit
if strategy.position_size == 0
    inV5 := false
    inV2 := false

// ═══════════════════════════════════════════════════════════════
// UPDATE CORRELATION TRACKING
// ═══════════════════════════════════════════════════════════════
if v5BuySignal or v5SellSignal
    ret = (close - close[1]) / close[1]
    array.push(v5_returns, ret)

if v2BuySignal or v2SellSignal
    ret = (close - close[1]) / close[1]
    array.push(v2_returns, ret)

current_corr := compute_correlation()

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(sma, "SMA", color=color.new(color.white, 50))
plot(v5Trail, "V5 Trail", color=color.new(color.lime, 30), style=plot.style_linebr)
plot(v2Trail, "V2 Trail", color=color.new(color.aqua, 30), style=plot.style_linebr)

// Signals
plotshape(v5BuySignal, "V5 Buy", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(v5SellSignal, "V5 Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(v2BuySignal, "V2 Buy", shape.triangleup, location.belowbar, color.aqua, size=size.tiny)
plotshape(v2SellSignal, "V2 Sell", shape.triangledown, location.abovebar, color.orange, size=size.tiny)

// Both signals
plotshape(bothSignals, "Both Signals", shape.diamond, location.belowbar, color.yellow, size=size.small)

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 75), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Correlation", text_color=color.white)
    table.cell(info, 1, 0, str.tostring(current_corr, "#.00"), 
         text_color=math.abs(current_corr) > maxCorr ? color.red : color.lime)
    table.cell(info, 0, 1, "V5 Allocation", text_color=color.white)
    table.cell(info, 1, 1, str.tostring(v5Alloc, "#.0") + "%", text_color=color.lime)
    table.cell(info, 0, 2, "V2 Allocation", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(v2Alloc, "#.0") + "%", text_color=color.aqua)
    table.cell(info, 0, 3, "In V5", text_color=color.white)
    table.cell(info, 1, 3, inV5 ? "YES" : "no", text_color=inV5 ? color.lime : color.gray)
    table.cell(info, 0, 4, "In V2", text_color=color.white)
    table.cell(info, 1, 4, inV2 ? "YES" : "no", text_color=inV2 ? color.aqua : color.gray)
    table.cell(info, 0, 5, "Corr Factor", text_color=color.white)
    table.cell(info, 1, 5, str.tostring(corrFactor, "#.00"), text_color=color.yellow)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(v5BuySignal, "V5 Buy", "V5 Absorption BUY signal")
alertcondition(v5SellSignal, "V5 Sell", "V5 Absorption SELL signal")
alertcondition(v2BuySignal, "V2 Buy", "V2 Range Breakout BUY signal")
alertcondition(v2SellSignal, "V2 Sell", "V2 Range Breakout SELL signal")
alertcondition(bothSignals, "Both Signals", "V5 + V2 CONFLUENCE signal")
