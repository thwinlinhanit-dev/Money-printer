# ops.env.example — alert-egress credentials for the money-printer ops stack.
#
# Copy to the deployment location and fill in the values:
#   Linux:  install -m 0600 /dev/null /etc/money-printer/ops.env   (then source it)
#   Windows: setx TELEGRAM_BOT_TOKEN "..."   (per-var; or use ops/scripts/set_ops_env.ps1)
#
# All variables are read from the process environment by mp-ops / opsd.
# Nothing here is a secret worth committing — this file is a template only.

# --- Telegram (P2 decay / monthly report channel, OPS-9) ----------------------
# Token from @BotFather (see README in ops/: /newbot -> paste token).
# TELEGRAM_BOT_TOKEN=
# Target chat id (message @userinfobot or use getUpdates once the bot runs).
# TELEGRAM_CHAT_ID=

# Optional override of the Bot API base URL (default https://api.telegram.org).
# MP_OPS_TELEGRAM_URL=

# Journal directory for undelivered batches + delivery ledger (default journal/telegram).
# MP_OPS_TELEGRAM_DIR=journal/telegram

# --- P1 webhook (phone-grade alerts, audit 08-04 #3) --------------------------
# HTTPS URL that receives the P1 dispatch JSON (mp-ops p1-webhook --id --detail).
# Dead until set: mp-ops exits 2 with "dead until credentials" when unset (PD-2).
# MP_OPS_P1_WEBHOOK=https://hooks.example.com/p1

# --- Ops daemon (opsd) ---------------------------------------------------------
# Bearer token opsd requires from watchers/check-ins.
# MP_OPSD_TOKEN=

# External ping URL opsd hits to prove it is alive (deploy.md: "the watcher has a watcher").
# OPSD_EXTERNAL_PING_URL=https://uptime.example.com/ping

# --- Quiet hours (UTC minutes of day, default 22:00-07:00 = 1320/420) ----------
# MP_OPS_QUIET_START_MIN=1320
# MP_OPS_QUIET_END_MIN=420

# Test-only: stub the internal sleeper (never set in production).
# MP_OPS_SLEEP=1
